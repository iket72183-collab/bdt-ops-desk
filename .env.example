# Server
PORT=3000
HOST=0.0.0.0

# MCP Bearer auth (optional). When set, clients must send:
#   Authorization: Bearer <token>
# Missing/invalid token => 401 with NO WWW-Authenticate header.
MCP_AUTH_TOKEN=

# GitHub hygiene tool (optional). Comma-separated owner/name list.
GITHUB_TOKEN=
GITHUB_REPOS=iket72183-collab/bdt-ops-desk

# Amazon Bedrock (optional). Uses default AWS credential chain when present.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Do not put real secrets in this file. Copy to .env for local use.
